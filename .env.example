APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Leave ASSET_URL empty in production so assets use APP_URL.
# ASSET_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Live database
# DB_CONNECTION=mysql
# DB_HOST=62.72.57.152
# DB_PORT=5200
# DB_DATABASE=default
# DB_USERNAME=mysql
# DB_PASSWORD=MFP6zSC4QsTn2TrGr7A7s2eNirUL4tRELP6KWGNBc7zVLxJwwagaePay8q3MNZAm

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=laravel-session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=laravel-cache-

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=laravel-database-

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@rrjob.info
MAIL_PASSWORD=your-hostinger-email-password
MAIL_FROM_ADDRESS="info@rrjob.info"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

YALLAPAY_ENABLED=true
YALLAPAY_ENV=sandbox
YALLAPAY_SANDBOX_URL=https://gateway-dev.yallapaysudan.com/api/v1
YALLAPAY_PRODUCTION_URL=https://gateway.yallapaysudan.com/api/v1
YALLAPAY_AUTH_TOKEN=
YALLAPAY_WEBHOOK_SECRET=
# Paste these into the YallaPay dashboard (Developer → Webhooks / Redirects):
YALLAPAY_WEBHOOK_URL="${APP_URL}/api/webhooks/yallapay"
YALLAPAY_SUCCESS_URL="${APP_URL}/payment/yallapay/success"
YALLAPAY_FAILED_URL="${APP_URL}/payment/yallapay/failed"

